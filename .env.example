# GameForge AI provider configuration
# Copy this file to .env.local and keep real keys private.

# Groq: Design Studio generation, AI Producer guidance, dialogue, and optional Final GDD enrichment.
GROQ_API_KEY=
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_MODEL=

# Optional generation budgets.
GROQ_WORLD_MAX_TOKENS=2800
GROQ_GDD_MAX_TOKENS=3600
# Keep false for resilient GDD generation. Strict schema mode is diagnostic only.
GROQ_GDD_STRICT_SCHEMA=false

# Cloudflare Workers AI: optional character concepts, world visuals, quest scenes,
# dialogue scenes, and GDD cover artwork.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_WORLD_IMAGE_MODEL=@cf/bytedance/stable-diffusion-xl-lightning
CLOUDFLARE_IMAGE_STEPS=8

# Optional Tripo API: 3D character or world-reference previews for design presentations.
TRIPO_API_KEY=
TRIPO_MODEL=P1-20260311

# Optional ElevenLabs voice previews for dialogue and narrative demonstrations.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
